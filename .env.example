# Copy to .env.local. Every value is optional for local development:
# with nothing set, the app uses a local Postgres (PGlite in .data/), stores clips in .data/uploads,
# and the coach gives sample answers (AI_PROVIDER=mock).

# Database (Neon). Run `npm run db:migrate` once after setting it.
DATABASE_URL=

# Auth (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Video storage (Vercel Blob, private store). Without it, clips are kept on this server.
BLOB_READ_WRITE_TOKEN=

# AI provider: gemini | openrouter | mock. When empty, the first key found wins.
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# GEMINI_FPS=2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash-lite

# Mock mode only: works | cant | fails. Lets you see the "can't review" and "failed" screens.
MOCK_OUTCOME=
